---
import Portfolio from "./portfolio.astro";

interface Props {
	title: string;
    items: any[];
}
const { title, items } = Astro.props;

---
<section id="portfolio" class="mx-auto w-full max-w-6xl px-6 py-16">
  <div class="mb-10 text-center">
    <span class="kicker">Projects</span>
    <h2 class="section-title mt-2">{title}</h2>
    <p class="mx-auto mt-3 max-w-lg text-sm text-offset">我近期参与与维护的一些开源项目</p>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => {
        return (
          <Portfolio
            title={item.title}
            description={item.description}
            url={item.url}
            github={item.github}
            stack={item.stack}
          />
        )
      })
    }
  </div>
</section>
