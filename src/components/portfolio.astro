---
interface Props {
	title: string;
    description: string;
    url: string;
    github: string;
    stack?: string[];
}

const { title, description, url, github, stack = [] } = Astro.props;
---
<article class="portfolio-card group relative flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:shadow-[0_25px_60px_-20px_rgba(168,85,247,0.55)]">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-xl font-bold text-white">{title}</h3>
    <span class="shrink-0 rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-[11px] font-medium text-offset">开源</span>
  </div>

  <p class="flex-1 text-sm leading-relaxed text-offset">{description}</p>

  {
    stack.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {stack.map((s) => (
          <span class="rounded-md bg-white/5 px-2 py-0.5 text-[11px] text-offset/90 ring-1 ring-white/10">{s}</span>
        ))}
      </div>
    )
  }

  <div class="flex gap-2 pt-1">
    {url !== "" && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 rounded-lg bg-white/5 px-3 py-1.5 text-xs font-medium text-body ring-1 ring-white/10 transition hover:bg-white/10"
      >
        演示 <span aria-hidden="true">↗</span>
      </a>
    )}
    {github !== "" && (
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 rounded-lg bg-gradient-to-r from-cyan-500/90 to-fuchsia-500/90 px-3 py-1.5 text-xs font-semibold text-white transition hover:opacity-90"
      >
        源码 <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>
