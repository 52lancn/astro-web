---
import UserProfileImage from '../assets/logo.png'
---

<header class="relative flex flex-col items-center px-6 pt-28 pb-14 text-center sm:pt-36">
  <!-- glow -->
  <div class="pointer-events-none absolute left-1/2 top-24 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-gradient-to-r from-cyan-500/30 via-purple-500/30 to-pink-500/30 blur-3xl"></div>

  <!-- avatar with rotating gradient ring -->
  <div class="group relative mb-8">
    <div class="absolute -inset-1 rounded-full opacity-70 blur-md transition duration-500 group-hover:opacity-100 animate-[spin_6s_linear_infinite]" style="background: conic-gradient(from 0deg, #22d3ee, #a855f7, #ec4899, #22d3ee);"></div>
    <img
      src={UserProfileImage.src}
      alt="52lancn"
      class="relative h-28 w-28 rounded-full border-2 border-white/20 object-cover shadow-2xl sm:h-32 sm:w-32"
    />
  </div>

  <h1 class="gradient-text font-display text-5xl font-extrabold tracking-tight sm:text-6xl md:text-[5rem]">
    52lancn
  </h1>

  <p class="mt-4 text-lg font-medium text-body sm:text-xl">全栈开发工程师 · Vue / React / Go</p>
  <p class="mt-3 max-w-xl text-sm leading-relaxed text-offset">
    热爱开源与工程化，擅长从后端服务到前端体验的全链路交付，打造优雅而可靠的产品。
  </p>

  <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
    <a
      href="https://github.com/52lancn"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-body backdrop-blur transition hover:border-white/30 hover:bg-white/10"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
        <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"></path>
      </svg>
      GitHub
    </a>
    <a
      href="#portfolio"
      class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-500 to-fuchsia-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/20 transition hover:opacity-90"
    >
      查看作品
    </a>
  </div>
</header>
