---
import Layout from "../layouts/layout.astro"
import Header from '../components/header.astro';
import GitHubCorner from "../components/github-corner.astro";
import List from "../components/list.astro";
import Techstack from "../components/techstack.astro";
import portfolio from '../data/portfolio.json';
import Footer from '../components/footer.astro';

const my_portfolio = portfolio;
---
<Layout title="52lancn · 个人作品集">
  <!-- Decorative background layers -->
  <div class="fixed inset-0 -z-20 bg-aurora"></div>
  <div class="pointer-events-none fixed inset-0 -z-10 bg-grid bg-grid-mask"></div>

  <section class="relative overflow-hidden">
    <GitHubCorner />
    <div class="relative mx-auto flex min-h-screen max-w-6xl flex-col px-4">
      <Header />
      <main class="flex-1">
        <List
          title={my_portfolio.title}
          items={my_portfolio.items}
        />
        <Techstack />
      </main>
      <Footer />
    </div>
  </section>
</Layout>
